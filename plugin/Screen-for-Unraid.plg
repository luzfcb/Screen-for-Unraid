<?xml version='1.0' standalone='yes'?>

<!DOCTYPE PLUGIN [
<!ENTITY name        "Screen-for-Unraid">
<!ENTITY author      "luzfcb">
<!ENTITY version     "2026.05.05">
<!ENTITY launch      "Settings/&name;">
<!ENTITY pluginURL   "https://raw.githubusercontent.com/luzfcb/Screen-for-Unraid/main/plugin/Screen-for-Unraid.plg">
<!ENTITY plgPATH     "/boot/config/plugins/&name;">
<!ENTITY iconURL     "https://raw.githubusercontent.com/luzfcb/Screen-for-Unraid/main/plugin-icon.png">
<!ENTITY iconPATH    "/usr/local/emhttp/plugins/&name;/&name;.png">

<!ENTITY screenPkgVer  "5.0.1">
<!ENTITY screenArch    "x86_64">
]>

<PLUGIN name="&name;" author="&author;" version="&version;" launch="&launch;" pluginURL="&pluginURL;" min="6.11">

  <ICON>&iconPATH;</ICON>

  <CHANGES>
### 2026.05.05
- Refactored to dynamically find the current build in Slackware repositories
- Fixed checksum discovery pattern

### 2026.01.23
- Install screen package with automatic checksum validation and mirror fallback

### 2024.06.11
- Initial release
  </CHANGES>

  <FILE Run="/usr/bin/php">
    <INLINE><![CDATA[
<?
  $info = parse_ini_file("/etc/unraid-version");
  if (version_compare($info["version"], "6.11.0", "<")) {
    echo "**********************************************************************\n\n";
    echo "This plugin requires Unraid 6.11.0 or newer\n\n";
    echo "**********************************************************************\n";
    exit(1);
  }

  // Best effort check, do not block install if this fails
  $plgFile = "/boot/config/plugins/&name;/&name;.plg";
  $installed = trim(shell_exec("plugin version " . escapeshellarg($plgFile) . " 2>/dev/null"));

  if ($installed && strpos($installed, "XML file doesn't exist") === false) {
    if (version_compare($installed, "&version;", ">=")) {
      echo "Installed plugin version ($installed) is up to date.\n";
      exit(0);
    }
  }
?>
]]></INLINE>
  </FILE>

  <FILE Run="/bin/bash">
    <INLINE>
mkdir -p "&plgPATH;"
mkdir -p "/usr/local/emhttp/plugins/&name;"

find "&plgPATH;" -maxdepth 1 -type f -name "screen-*.txz" -delete 2>/dev/null || true

# Download plugin icon
if wget -q --timeout=20 --tries=2 -O "&iconPATH;" "&iconURL;"; then
  chmod 0644 "&iconPATH;" 2>/dev/null || true
fi

exit 0
    </INLINE>
  </FILE>

  <FILE Run="/bin/bash" Method="install">
    <INLINE>
set -e

pkg_ver="&screenPkgVer;"
pkg_arch="&screenArch;"
sums_path="&plgPATH;/CHECKSUMS.md5"

mirrors="http://slackware.uk/slackware/slackware64-current http://mirrors.slackware.com/slackware/slackware64-current http://slackware.osuosl.org/slackware64-current"

download_first_working() {
  out="$1"
  shift
  for url in "$@"; do
    echo "Trying $url"
    if wget -q --timeout=20 --tries=2 -O "$out" "$url"; then
      return 0
    fi
  done
  return 1
}

echo ""
echo "-----------------------------------------------------------"
echo " &name; installing"
echo " Plugin version: &version;"
echo " Target: screen-$pkg_ver-$pkg_arch"
echo "-----------------------------------------------------------"
echo ""

echo "Downloading checksums"
sums_urls=""
for root in $mirrors; do
  sums_urls="$sums_urls $root/slackware64/CHECKSUMS.md5"
done

if ! download_first_working "$sums_path" $sums_urls; then
  echo "ERROR: Could not download CHECKSUMS.md5 from any mirror"
  exit 1
fi

# Find the entry in CHECKSUMS.md5 (allowing for different path prefixes)
line=$(grep -E "ap/screen-${pkg_ver}-${pkg_arch}-.+\.txz$" "$sums_path" | head -n 1)
if [ -z "$line" ]; then
  echo "ERROR: Could not find build for screen-${pkg_ver}-${pkg_arch} in remote repository"
  exit 1
fi

expected=$(echo "$line" | awk '{print $1}')
remote_rel_path=$(echo "$line" | awk '{print $2}"' | sed 's|^\./||')
pkg_file=$(basename "$remote_rel_path")
pkg_path="&plgPATH;/$pkg_file"

echo "Downloading package"
pkg_urls=""
for root in $mirrors; do
  pkg_urls="$pkg_urls $root/slackware64/$remote_rel_path"
done

if ! download_first_working "$pkg_path" $pkg_urls; then
  echo "ERROR: Could not download $pkg_file from any mirror"
  exit 1
fi

actual="$(md5sum "$pkg_path" | awk '{print $1}')"
if [ "$actual" != "$expected" ]; then
  echo "ERROR: Checksum mismatch for $pkg_file"
  echo "Expected: $expected"
  echo "Actual:   $actual"
  exit 1
fi

echo "Checksum verified"
upgradepkg --install-new --reinstall "$pkg_path"

echo ""
echo "-----------------------------------------------------------"
echo " &name; has been installed."
echo " Copyright 2024, &author;"
echo " Plugin version: &version;"
echo "-----------------------------------------------------------"
echo ""
    </INLINE>
  </FILE>

  <FILE Run="/bin/bash" Method="remove">
    <INLINE>
set -e

removepkg screen 2>/dev/null || true

rm -f "&plgPATH;/screen-*.txz" 2>/dev/null || true
rm -f "&plgPATH;/CHECKSUMS.md5" 2>/dev/null || true
rm -rf "&plgPATH;"

rm -rf "/usr/local/emhttp/plugins/&name;"

echo ""
echo "-----------------------------------------------------------"
echo " &name; has been removed."
echo " Copyright 2024, &author;"
echo " Plugin version: &version;"
echo "-----------------------------------------------------------"
echo ""
    </INLINE>
  </FILE>

</PLUGIN>
